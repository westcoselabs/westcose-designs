              "fill": "$wc-stone-500",
              "textGrowth": "fixed-width",
              "width": 1360,
              "content": "SCROLL: cards stagger up after the shirts  ·  CLICK a card: it grows to ~70% width, the others stack as tabs on the right  ·  The print method card pre-selects whatever fits the chosen art",
              "lineHeight": 1.5,
              "fontFamily": "$wc-font-mono",
              "fontSize": 12,
              "fontWeight": "500",
              "letterSpacing": 1
            }
