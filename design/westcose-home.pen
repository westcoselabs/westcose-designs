              "content": "ENTER blank tee + film plates  ·  BUILD 4 ink passes, one per quarter of the pin  ·  HOLD finished tee  ·  EXIT tee lifts toward the Scene 05 stationery",
              "lineHeight": 1.5,
              "fontFamily": "$wc-font-mono",
              "fontSize": 12,
              "fontWeight": "500",
              "letterSpacing": 1
            }
