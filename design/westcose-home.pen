              "id": "oTh7o",
              "name": "CAPTION / MOTION",
              "fill": "$wc-stone-500",
              "textGrowth": "fixed-width",
              "width": 1360,
              "content": "CLICK ‹ › on either shirt: it slides out sideways and the next design slides in (~350ms), the chest-hit callout redraws  ·  The kit panel's chips light up in sequence on scroll",
              "lineHeight": 1.5,
              "fontFamily": "$wc-font-mono",
              "fontSize": 12,
              "fontWeight": "500",
              "letterSpacing": 1
            }
