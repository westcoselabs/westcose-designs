                              "content": "MARK IN ORBIT · PULLBACK"
                            },
                            "UISeQ": {
                              "content": "The page opens tight on the W of the Designs world, then pulls back as the visitor scrolls, using the same reversible pullback as Built Here. The orbit rings draw in, and the six application nodes launch along them and ease into their slots. After the pin the nodes keep a slow drift, and the front arc passes in front of the world for depth."
                            },
                            "h2KBO": {
                              "content": "pullback scale 2.4 → 1 · node stagger 120ms · drift 0.6°/s"
                            },
                            "s3ShWS": {
                              "content": "↳ studio-scene-motion.tsx · ecosystem-orbit-runtime.tsx · orbit-worlds.ts"
                            }
                          }
                        },
