            {
              "type": "text",
              "id": "D29pS",
              "name": "CAPTION / RATIONALE",
              "fill": "$wc-stone-300",
              "textGrowth": "fixed-width",
              "width": 1200,
              "content": "Introduces web design as the next service, shown with WestCose's own site in layered browser windows and a phone. The proof is real: visitors have just scrolled the site it's showing.",
              "lineHeight": 1.5,
              "fontFamily": "$wc-font-body",
              "fontSize": 16,
              "fontWeight": "500"
            },
            {
              "type": "text",
              "id": "kJGkk",
              "name": "CAPTION / MOTION",
              "fill": "$wc-stone-500",
              "textGrowth": "fixed-width",
              "width": 1360,
              "content": "HOLD: windows drift apart on scroll; chips light in sequence  ·  EXIT: the browser tab icon grows into the W while the windows tilt away into space and become the planet orbit",
              "lineHeight": 1.5,
              "fontFamily": "$wc-font-mono",
              "fontSize": 12,
              "fontWeight": "500",
              "letterSpacing": 1
            }
          ]
        },
