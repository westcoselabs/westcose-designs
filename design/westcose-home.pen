              "name": "CAPTION / RATIONALE",
              "fill": "$wc-stone-300",
              "textGrowth": "fixed-width",
              "width": 1200,
              "content": "The most cinematic web option. One browser shows the wireframe on the left and the finished site on the right; scrolling sweeps the orange build line across while the MAP → WIRE → DESIGN → LAUNCH steps fill.",
              "lineHeight": 1.5,
              "fontFamily": "$wc-font-body",
              "fontSize": 16,
              "fontWeight": "500"
            },
            {
              "type": "text",
              "id": "W8fxN",
              "name": "CAPTION / MOTION",
              "fill": "$wc-stone-500",
              "textGrowth": "fixed-width",
              "width": 1360,
              "content": "HOLD: scroll moves the build line 0 → 100%; visitors can also drag the handle  ·  EXIT: the finished page folds into a single line of light, and the W ignites at its center",
              "lineHeight": 1.5,
              "fontFamily": "$wc-font-mono",
              "fontSize": 12,
              "fontWeight": "500",
              "letterSpacing": 1
            }
          ]
        },
