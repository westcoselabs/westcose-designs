                              "content": "SCROLL FX 02"
                            },
                            "l2bxr": {
                              "content": "LOOP · VELOCITY"
                            },
                            "LImiu": {
                              "content": "COUNTER-RUNNING MARQUEES"
                            },
                            "UISeQ": {
                              "content": "Three bands run against each other. Marks drift left, service names drift right, and the second band of marks runs slower. Scroll velocity speeds all three up before they ease back to idle. Ghost words alternate at 14% so the line reads as rhythm, not a list."
                            },
                            "h2KBO": {
                              "content": "idle 20 / 28 / 14 px/s · velocity × 0.35"
                            },
                            "s3ShWS": {
                              "content": "↳ new marks-marquee.tsx (shared with A6)"
                            }
                          }
