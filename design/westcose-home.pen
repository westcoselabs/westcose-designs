                            },
                            "UISeQ": {
                              "content": "Construction draws before the mark appears. The grid fades in, the axes and circles stroke-draw from the center, the clear-space box traces clockwise, and the X labels type on in mono. Then the seal fades up inside the guides, the guides dim to 30%, and the swatches and min-size ladder count in."
                            },
                            "h2KBO": {
                              "content": "stroke-draw 900ms each · type 18ms/char · guides → 30%"
                            },
                            "s3ShWS": {
                              "content": "↳ scene-00 STROKE_DRAW → GUIDES_ON → FINAL_MARK pattern"
                            }
