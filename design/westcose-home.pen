              "name": "CAPTION / MOTION",
              "fill": "$wc-stone-500",
              "textGrowth": "fixed-width",
              "width": 1360,
              "content": "HOLD: spreads deal in one by one, each rule highlights  ·  EXIT: spreads fan into a ring around the mark, which lifts off page 01 and becomes the core",
              "lineHeight": 1.5,
              "fontFamily": "$wc-font-mono",
              "fontSize": 12,
              "fontWeight": "500",
              "letterSpacing": 1
